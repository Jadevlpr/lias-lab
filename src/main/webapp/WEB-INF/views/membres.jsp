<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Membres · LIAS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><section class="page-head"><div class="container"><h1>Membres du laboratoire</h1><p>Profils, statuts et affiliations historisés.</p></div></section><main class="container"><div class="panel"><a class="button" href="${pageContext.request.contextPath}/admin/membres/nouveau">Ajouter un membre</a><c:if test="${not empty sessionScope.succes}"><div class="alert"><c:out value="${sessionScope.succes}"/></div><c:remove var="succes" scope="session"/></c:if><br><br><table class="table"><thead><tr><th>Membre</th><th>E-mail</th><th>Statut actuel</th><th>Établissement</th></tr></thead><tbody><c:forEach var="membre" items="${membres}"><tr><td><strong><c:out value="${membre.prenom}"/> <c:out value="${membre.nom}"/></strong></td><td><c:out value="${membre.email}"/></td><td><span class="badge"><c:out value="${membre.statut}" default="Non renseigné"/></span></td><td><c:out value="${membre.etablissement}" default="—"/></td></tr></c:forEach><c:if test="${empty membres}"><tr><td colspan="4">Aucun membre enregistré pour le moment.</td></tr></c:if></tbody></table></div></main><%@ include file="fragments/footer.jspf" %></body></html>
