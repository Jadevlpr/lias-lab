<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Connexion · LIAS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="container section" style="max-width:650px"><div class="panel"><div class="eyebrow" style="color:#1b567b">Espace sécurisé</div><h1>Connexion membre</h1><p class="section-intro">Accédez aux outils administratifs et scientifiques du laboratoire.</p><c:if test="${not empty erreur}"><div class="alert error"><c:out value="${erreur}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/login"><div class="field"><label for="email">E-mail</label><input id="email" type="email" name="email" required></div><br><div class="field"><label for="motDePasse">Mot de passe</label><input id="motDePasse" type="password" name="motDePasse" required></div><br><button class="button" type="submit">Se connecter</button></form></div></main><%@ include file="fragments/footer.jspf" %></body></html>
