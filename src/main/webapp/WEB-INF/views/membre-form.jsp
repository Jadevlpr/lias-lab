<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Nouveau membre · LIAS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><section class="page-head"><div class="container"><h1>Ajouter un membre</h1><p>Création d’un compte, d’un profil et d’une affiliation initiale.</p></div></section><main class="container"><div class="panel"><c:if test="${not empty erreur}"><div class="alert error"><c:out value="${erreur}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/admin/membres/nouveau"><div class="form-grid"><div class="field"><label>Nom *</label><input name="nom" required></div><div class="field"><label>Prénom *</label><input name="prenom" required></div><div class="field"><label>E-mail *</label><input type="email" name="email" required></div><div class="field"><label>Mot de passe initial *</label><input type="password" name="motDePasse" required></div><div class="field"><label>Statut *</label><select name="statut" required><option value="PERMANENT">Permanent</option><option value="ASSOCIE">Associé</option><option value="DOCTORANT">Doctorant</option><option value="RETRAITE">Retraité</option><option value="ANCIEN">Ancien membre</option></select></div><div class="field"><label>Début d’affiliation *</label><input type="date" name="dateDebutAffiliation" required></div><div class="field"><label>Date de naissance</label><input type="date" name="dateNaissance"></div><div class="field"><label>Date d’embauche</label><input type="date" name="dateEmbauche"></div><div class="field"><label>Établissement d’origine</label><input name="etablissementOrigine"></div><div class="field"><label>Laboratoire d’origine</label><input name="laboratoireOrigine"></div><div class="field full"><label>Biographie</label><textarea name="biographie"></textarea></div><div class="field full"><label>Centres d’intérêt</label><textarea name="centresInteret"></textarea></div></div><br><button class="button" type="submit">Créer le membre</button><a style="margin-left:15px" href="${pageContext.request.contextPath}/admin/membres">Annuler</a></form></div></main><%@ include file="fragments/footer.jspf" %></body></html>
